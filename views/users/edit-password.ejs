<%- include("../partials/code-header") %>
<main class="main-content">
  <h2 style="margin-bottom: 25px">Change Password</h2>
  <div class="form-wrapper">
    <% if (typeof errors !=='undefined' && errors.length> 0) { %>
    <div style="color: red">
      <ul>
        <% errors.forEach(error=> { %>
        <li><%= error.msg %></li>
        <% }) %>
      </ul>
    </div>
    <% } %>
    
    <div class="detail-item">
      <span class="label">Name:</span>
      <span class="value"><%= user.name %></span>
    </div>
    <form class="styled-form" action="/api/users/pw/<%= user._id %>" method="POST">
      <div class="form-group">
        <label for="curr-password">Current Password</label>
        <input type="password" name="curr-password" id="curr-password" />
      </div>
      <div class="form-group">
        <label for="new-password">New Password</label>
        <input type="password" name="new-password" id="new-password" />
      </div>
      <div class="form-group">
        <label for="conf-password">Confirm Password</label>
        <input type="password" name="conf-password" id="conf-password" />
      </div>

      <div class="btn-group">
        <button type="submit" class="btn submit-btn">Update Password</button>
        <a href="/api/users/personal/<%= user._id %>" class="btn btn-cancel">Cancel</a>
      </div>
    </form>
  </div>
</main>
<%- include("../partials/code-footer") %>
