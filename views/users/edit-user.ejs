<%- include("../partials/code-header") %>
<main class="main-content">
  <h2 style="margin-bottom: 25px">Edit User</h2>
  <div class="form-wrapper">
    <% if (typeof errors !=='undefined' && errors.length> 0) { %>
        <div style="color: red">
          <ul>
            <% errors.forEach(error=> { %>
              <li>
                <%= error.msg %>
              </li>
              <% }) %>
          </ul>
        </div>
        <% } %>
    <form class="styled-form" action="/api/users/edit/<%= user._id %>" method="POST">
      <div class="form-group">
        <label for="name">Name</label>
        <input type="text" name="name" id="name" value="<%= oldInput.name ? oldInput.name : user.name %>"/>
      </div>

      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" name="email" id="email" value="<%= oldInput.email ? oldInput.email : user.email %>"/>
      </div>
      
      <div class="form-group">
        <label for="password">Password (leave blank to keep unchanged)</label>
        <input type="password" name="password" id="password" />
      </div>
      
      <div class="form-group">
        <label for="role">User Role</label>
        <select name="role" id="role">
          <option value="user" <%= (oldInput.role ? oldInput.role : user.role) === "user" ? "selected" : "" %>>User</option>
          <option value="admin" <%= (oldInput.role ? oldInput.role : user.role) === "admin" ? "selected" : "" %>>Admin</option>
        </select>

        <div class="form-group">
        <label for="isActive">Is Active</label>
        <select name="isActive" id="isActive">
          <option value="Y" <%= (oldInput.isActive ? oldInput.isActive : user.isActive) === "Y" ? "selected" : "" %>>Yes</option>
          <option value="N" <%= (oldInput.isActive ? oldInput.isActive : user.isActive) === "N" ? "selected" : "" %>>No</option>
        </select>
      </div>

      <div class="btn-group">
        <button type="submit" class="btn submit-btn">Update User</button>
        <a href="#" class="btn btn-danger" onclick="confirmDelete('/api/users/delete/<%= user._id %>')">Delete</a>
        <a href="/api/users/<%= user.role %>" class="btn btn-cancel">Cancel</a>
      </div>
    </form>
  </div>
</main>
<%- include("../partials/code-footer") %>
