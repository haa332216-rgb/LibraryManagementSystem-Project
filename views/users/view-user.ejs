<%- include("../partials/code-header") %>
<main class="main-content">
  <h2 style="margin-bottom: 25px"><%= user.role === "admin" ? "Admin" : "User" %> Details</h2>

  <div class="content-details">
    <div class="detail-item">
      <span class="label"><%= user.role === "admin" ? "Admin" : "User" %> ID:</span>
      <span class="value"><%= user._id %></span>
    </div>
    <div class="detail-item">
      <span class="label">Name:</span>
      <span class="value"><%= user.name %></span>
    </div>
    <div class="detail-item">
      <span class="label">Email:</span>
      <span class="value"><%= user.email %></span>
    </div>
    <div class="detail-item">
      <span class="label">Created At:</span>
      <span class="value"><%= user.createdAt.toISOString().split('T')[0] %></span>
    </div>
    <div class="detail-item">
      <span class="label">Role:</span>
      <span class="value"><%= user.role %></span>
    </div>
    <div class="detail-item">
      <span class="label">Active:</span>
      <span class="value"><%= user.isActive %></span>
    </div>
  </div>

  <a href="/api/users/edit/<%= user._id %>" class="btn">Update</a>
  <a href="#" class="btn btn-danger" onclick="confirmDelete('/api/users/delete/<%= user._id %>')">Delete</a>
  <a href="/api/users/<%= user.role %>" class="btn btn-cancel">Back</a>
</main>
<%- include("../partials/code-footer") %>
