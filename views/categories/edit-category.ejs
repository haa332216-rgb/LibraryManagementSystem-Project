<%- include("../partials/code-header") %>
<main class="main-content">
  <h2 style="margin-bottom: 25px">Update Category</h2>
  <div class="form-wrapper">
    <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
    <div style="color: red">
      <ul>
        <% errors.forEach(error => { %>
        <li><%= error.msg %></li>
        <% }) %>
      </ul>
    </div>
    <% } %>
    <form class="styled-form" action="/api/category/edit/<%= category._id %>" method="POST">

      <div class="form-group">
        <label for="name">Name</label>
        <input type="text" name="name" id="name" value="<%= oldInput.name ? oldInput.name : category.name %>"/>
      </div>

      <div class="form-group">
        <label for="description">Description</label>
        <input type="text" name="description" id="description" value="<%= oldInput.description ? oldInput.description : category.description %>"/>
      </div>

      <div class="btn-group">
        <button type="submit" class="btn submit-btn">Update Category</button>
        <a href="#" class="btn btn-danger" onclick="confirmDelete('/api/category/delete/<%= category._id %>')">Delete</a>
        <a href="/api/category" class="btn btn-cancel">Cancel</a>
      </div>
    </form>
  </div>
</main>
<%- include("../partials/code-footer") %>
