<%- include("../partials/code-header") %>
<main class="main-content">
  <div class="page-header">
    <h1>Books</h1>
    <a href="/api/books/add" class="add-button">➕ Add Book</a>
  </div>

  <table class="styled-table">
    <thead>
      <tr>
        <th>#</th>
        <th>Title</th>
        <th>Author</th>
        <th>Category</th>
        <th>ISBN</th>
        <!-- <th>Total</th> -->
        <th>Available</th>
        <!-- <th>Shelf</th> -->
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% books.forEach((book, index) => { %>
      <tr>
        <td><%= index + 1 %></td>
        <td><%= book.title %></td>
        <td><%= book.authorName %></td>
        <td><%= book.categoryId ? book.categoryId.name : 'Uncategorized' %></td>
        <td><%= book.isbn %></td>
        <td><%= book.copiesAvailable %></td>
        <td class="action-links">
          <a href="/api/books/<%= book._id %>">View</a>
          <a href="/api/books/edit/<%= book._id %>">Edit</a>
          <a href="#" style="color: red;" onclick="confirmDelete('/api/books/delete/<%= book._id %>')">Delete</a>
          <!-- <a href="/books/delete/%= book._id %>" style="color: red">Delete</a> -->
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</main>
<%- include("../partials/code-footer") %>
